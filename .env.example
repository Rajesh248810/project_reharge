# Django Settings
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Aiven PostgreSQL)
# You can get these details from your Aiven Console
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_HOST=your-aiven-host-name.aivencloud.com
DB_PORT=25060
DB_SSLMODE=require

# OpenClaw WhatsApp Gateway
OPENCLAW_API_URL=http://localhost:3000/api
OPENCLAW_API_KEY=your-openclaw-token-here

# Remotion Video Config
REMOTION_RENDER_DIR=./media/renders
