FROM python:3.12-slim

# Install curl and Node.js setup keys
RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install system dependencies for Chromium/Puppeteer and Python postgres
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    wget \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libc6 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libgcc1 \
    libgconf-2-4 \
    libgdk-pixbuf2.0-0 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    librenderdoc-dev \
    libxrender1 \
    libxss1 \
    libxtst6 \
    chromium \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Set up Puppeteer environment to use pre-installed Chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Set working directory
WORKDIR /usr/src/app

# Copy and install python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy video renderer package files and install node packages
COPY video_renderer/package*.json ./video_renderer/
RUN cd video_renderer && npm install

# Copy application source code
COPY . .

# Run collectstatic on build
RUN python manage.py collectstatic --noinput

# Expose Django port
EXPOSE 8000

# Run migrations and start gunicorn in production
CMD ["sh", "-c", "python manage.py migrate && gunicorn cable_assistant.wsgi:application --bind 0.0.0.0:8000"]
